{
  "name": "plan",
  "skipWatching": true,
  "services": [],
  "workflow": [
    {
      "id": "fetch-ticket",
      "type": "script",
      "script": "scripts/fetch-ticket.js",
      "stateWrites": ["ticket_identifier", "ticket_url", "ticket_title", "plan_status"]
    },
    {
      "id": "analyze-ticket",
      "type": "claude-tui",
      "skill": "analyze-ticket",
      "runIf": "state.plan_status !== 'found'",
      "stateReads": ["ticket_identifier", "ticket_url", "ticket_title"],
      "stateWrites": ["needs_questions", "needs_sketch"]
    },
    {
      "id": "ask-questions",
      "type": "claude-tui",
      "skill": "ask-questions",
      "awaitsReview": "question",
      "runIf": "state.needs_questions === 'true'",
      "stateReads": ["ticket_identifier", "ticket_url"],
      "stateWrites": []
    },
    {
      "id": "sketch",
      "type": "claude-tui",
      "skill": "sketch",
      "runIf": "state.needs_sketch === 'true'",
      "stateReads": ["ticket_identifier", "ticket_url"],
      "stateWrites": ["sketch_file", "sketch_url"]
    },
    {
      "id": "sketch-review-loop",
      "type": "loop",
      "runIf": "state.needs_sketch === 'true'",
      "minIterations": 1,
      "maxIterations": 200,
      "exitCondition": "state.sketch_status === 'ended'",
      "steps": [
        {
          "id": "sketch-poll",
          "type": "claude-tui",
          "skill": "sketch-poll",
          "awaitsReview": "review",
          "stateReads": ["sketch_file", "sketch_url"],
          "stateWrites": ["sketch_status"]
        },
        {
          "id": "sketch-feedback",
          "type": "claude-tui",
          "skill": "sketch-feedback",
          "runIf": "state.sketch_status === 'feedback'",
          "stateReads": ["sketch_file"]
        }
      ]
    },
    {
      "id": "sketch-finalize",
      "type": "claude-tui",
      "skill": "sketch-finalize",
      "runIf": "state.needs_sketch === 'true' && state.sketch_status === 'ended'",
      "stateReads": ["sketch_file"]
    }
  ]
}
