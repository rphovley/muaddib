{
  "name": "bug",
  "services": [
    { "name": "webhook", "script": "services/watch-feedback.js" },
    {
      "name": "servers",
      "script": "services/start-servers.js",
      "readyEvent": "tunnel_ready"
    }
  ],
  "workflow": [
    {
      "id": "fetch-ticket",
      "type": "script",
      "script": "scripts/fetch-ticket.js",
      "stateWrites": [
        "ticket_identifier",
        "ticket_url",
        "ticket_title",
        "plan_status"
      ]
    },
    {
      "id": "gather-context",
      "type": "script",
      "script": "scripts/gather-context.js",
      "stateReads": ["ticket_identifier", "ticket_url"],
      "stateWrites": ["context_status"]
    },
    {
      "id": "branch",
      "type": "script",
      "script": "scripts/branch.sh",
      "stateReads": ["ticket_identifier", "ticket_title"],
      "stateWrites": ["branch"]
    },
    {
      "id": "analyze-ticket",
      "type": "claude-tui",
      "skill": "analyze-ticket",
      "runIf": "state.plan_status !== 'found'",
      "stateReads": ["ticket_identifier", "ticket_url", "ticket_title"],
      "stateWrites": ["needs_questions"],
      "mockStateWrites": [["needs_questions", "false"]]
    },
    {
      "id": "ask-questions",
      "type": "claude-tui",
      "skill": "ask-questions",
      "awaitsReview": "question",
      "runIf": "state.needs_questions === 'true'",
      "stateReads": ["ticket_identifier", "ticket_url"],
      "stateWrites": [],
      "mockStateWrites": []
    },
    {
      "id": "size-and-schedule-propose",
      "type": "script",
      "script": "scripts/size-and-schedule.js",
      "args": ["--propose"],
      "stateReads": ["ticket_identifier", "ticket_title"],
      "stateWrites": ["recommend_split", "sub_issues_plan"]
    },
    {
      "id": "sizing-review-loop",
      "type": "loop",
      "runIf": "state.recommend_split === 'true'",
      "minIterations": 1,
      "maxIterations": 200,
      "exitCondition": "state.sizing_confirm === 'dispatch' || state.sizing_confirm === 'tickets_only'",
      "steps": [
        {
          "id": "confirm-sizing",
          "type": "claude-tui",
          "skill": "confirm-sizing",
          "awaitsReview": "review",
          "stateReads": ["ticket_identifier", "ticket_url"],
          "stateWrites": ["sizing_confirm"]
        },
        {
          "id": "adjust-sizing",
          "type": "claude-tui",
          "skill": "adjust-sizing",
          "runIf": "state.sizing_confirm === 'adjust'",
          "stateReads": ["ticket_identifier", "ticket_url"]
        }
      ]
    },
    {
      "id": "size-and-schedule-commit",
      "type": "script",
      "script": "scripts/size-and-schedule.js",
      "args": ["--commit"],
      "runIf": "state.sizing_confirm === 'dispatch' || state.sizing_confirm === 'tickets_only'",
      "stateReads": ["ticket_identifier", "ticket_title", "sizing_confirm"],
      "stateWrites": ["recommend_split", "sub_issues"]
    },
    {
      "id": "implement-bug",
      "type": "claude-tui",
      "skill": "implement-bug",
      "runIf": "state.recommend_split !== 'true'",
      "stateReads": ["branch", "ticket_identifier"]
    },
    {
      "id": "implement-check-loop",
      "type": "loop",
      "runIf": "state.recommend_split !== 'true'",
      "minIterations": 1,
      "maxIterations": 5,
      "exitCondition": "state.check_status === 'pass'",
      "steps": [
        {
          "id": "checks",
          "type": "script",
          "script": "scripts/run-checks.sh",
          "stateWrites": ["check_status", "check_output"]
        },
        {
          "id": "fix-checks",
          "type": "claude-tui",
          "skill": "fix-checks",
          "runIf": "state.check_status === 'fail'",
          "stateReads": ["check_output"]
        }
      ]
    },
    {
      "id": "review",
      "type": "claude-tui",
      "skill": "review-fleet",
      "runIf": "state.recommend_split !== 'true'",
      "stateReads": ["ticket_url", "ticket_identifier"],
      "stateWrites": ["review_status", "review_findings"]
    },
    {
      "id": "fix-review",
      "type": "claude-tui",
      "skill": "fix-review",
      "runIf": "state.review_status === 'needs_fix'",
      "stateReads": ["review_findings"]
    },
    {
      "id": "review-check-loop",
      "type": "loop",
      "minIterations": 1,
      "maxIterations": 5,
      "exitCondition": "state.check_status === 'pass'",
      "runIf": "state.review_status === 'needs_fix'",
      "steps": [
        {
          "id": "checks",
          "type": "script",
          "script": "scripts/run-checks.sh",
          "stateWrites": ["check_status", "check_output"]
        },
        {
          "id": "fix-checks",
          "type": "claude-tui",
          "skill": "fix-checks",
          "runIf": "state.check_status === 'fail'",
          "stateReads": ["check_output"]
        }
      ]
    },
    {
      "id": "wrapup",
      "type": "claude-tui",
      "skill": "commit-and-pr",
      "runIf": "state.recommend_split !== 'true'",
      "stateReads": ["branch", "ticket_url", "api_tunnel_url", "portal_url", "homeowner_url"],
      "stateWrites": ["pr_number"]
    }
  ]
}
