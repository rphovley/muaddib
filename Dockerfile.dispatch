# Dispatch daemon image — lightweight Node.js container that listens for Linear
# webhooks via a cloudflared tunnel and routes new tickets to worker containers.
# BUILD CONTEXT IS THE REPO ROOT:
#   docker build -f muaddib/Dockerfile.dispatch -t <project>-dispatch .
#
# Does NOT bake source — the repo is bind-mounted at runtime (/repo).
# Requires /var/run/docker.sock so it can call `docker compose` to spawn workers.
FROM node:26-slim

# Toolchain: git (auto-detect REPO_URL from the mounted repo), bash + curl (scripts),
# jq (spawn-worker.sh's read-config.sh hard-requires it to parse .muaddib/manifest.json —
# without it, every daemon-triggered dispatch fails at spawn-worker.sh startup).
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git jq openssh-client wget \
    && rm -rf /var/lib/apt/lists/*

# docker CLI + compose plugin — daemon calls `docker ps`; spawn-worker.sh calls
# `docker compose up` via the bind-mounted host socket. buildx plugin is required
# too: without it `docker build` silently falls back to the legacy builder, which
# has no incremental context caching — every spawn-worker.sh image-rebuild check
# that trips (e.g. any change under claude/) re-tars the ENTIRE bind-mounted repo
# from scratch every time, an order of magnitude slower than the same build run
# natively (where Docker Desktop's CLI already defaults to BuildKit).
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
            -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
             https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# cloudflared — quick tunnel for the Linear webhook (no account needed).
RUN CF_ARCH=$(dpkg --print-architecture) \
    && wget -nv -O /usr/local/bin/cloudflared \
       "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${CF_ARCH}" \
    && chmod +x /usr/local/bin/cloudflared

WORKDIR /repo
ENV REPO_ROOT=/repo

CMD ["node", "services/dispatch-daemon.js"]
