# =============================================================================
# Account-level secrets for the muaddib dispatch daemon (and future Conductor).
#
# Copy to ~/.muaddib/conductor-secrets.env and lock it down:
#   mkdir -p ~/.muaddib
#   cp .muaddib/conductor-secrets.env.example ~/.muaddib/conductor-secrets.env
#   chmod 600 ~/.muaddib/conductor-secrets.env
# (install.sh does all of this for you and fills it from your shell env.)
#
# WHY THIS FILE EXISTS
#   ~/.zshrc exports CLAUDE_CODE_OAUTH_TOKEN / GITHUB_TOKEN only for *interactive*
#   shells. A daemon started at reboot / launchd / cron inherits neither, so the
#   docker-compose interpolation in docker-compose.dispatch.yml (and spawn-worker.sh
#   downstream) breaks — silently. dispatch.sh sources this file at its own startup
#   to supply the tokens. Shell env still wins: a var already set in the
#   environment is left untouched, so interactive `muaddib:start` is unaffected.
#
#   Do NOT move these exports to ~/.zshenv (sourced unconditionally) instead —
#   that exposes a Claude subscription token and a GitHub PAT to *every* process
#   on the machine, not just the daemon that needs them.
#
# Override the path with CONDUCTOR_SECRETS_FILE if you keep it elsewhere.
# The real file lives in $HOME and is git-ignored; only this .example is tracked.
# =============================================================================

# Claude subscription token — `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=


