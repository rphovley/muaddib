# Node dependencies (this repo's first package.json carries the Claude Agent
# SDK for services/conductor.js; the tree itself is never committed).
node_modules/

# Real secret bundle (only the .example is tracked)
non-prod.env

# Self-hosting SDLC Pack secrets (only .muaddib/secrets.env.example is tracked)
.muaddib/secrets.env

# Account-level daemon secrets. The real file lives in ~/.muaddib/, but guard
# against an accidental repo-local copy (only the .example is tracked).
conductor-secrets.env

# Per-worker env files (subscription + GitHub tokens) now live under
# ~/.muaddib/<project>/workers/, outside any repo. Defense-in-depth guard against
# a stray repo-local copy from an older layout.
.worker-*.env
.muaddib/.worker-*.env

# Live worker status files
status/

# Host-mounted screenshot inbox (contents are transient)
screenshots/

# Dispatch daemon runtime files (dedup ledger + queue) now live under
# ~/.muaddib/<project>/. When the manifest can't be read the queue module falls
# back to writing dispatch-queue.json/dispatch.json in the repo tree — guard those
# fallback names. The .muaddib-dispatch* entries are the older layout (still read
# once for migration), kept as defense-in-depth alongside the daemon's pid/log.
dispatch-queue.json
dispatch.json
../dispatch-queue.json
../dispatch.json
../.muaddib-dispatch-queue.json
../.muaddib-dispatch.json
../.muaddib-dispatch.pid
../.muaddib-dispatch.log
