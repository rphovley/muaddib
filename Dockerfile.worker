# Worker image: an isolated, all-commands-enabled Claude Code session.
# Extends muaddib-base:latest (toolchain layer). Build context is repo root.
# Build both images with: npm run muaddib:build
# Or use a project's .muaddib/Dockerfile.worker to override this file.
FROM muaddib-base:latest

WORKDIR /home/worker/repo

# Bake the full repo source + .git into the image so startup only needs a
# fast `git fetch --depth 1` (just the delta since the image was built) instead
# of cloning from GitHub from scratch. node_modules is excluded via dockerignore.
COPY --chown=worker:worker . /home/worker/repo/

# --- Pre-install project dependencies (Linux-native) -------------------------
# The project list is never hardcoded here — it's read from the project's own
# .muaddib/manifest.json (baked in above via the full-repo COPY), the same
# config worker-entrypoint.sh reads for lockfile-drift checks at spawn time.
# Projects that aren't npm packages (no package.json) are skipped. Each baked
# lockfile is stashed under ~/.deps-lock for drift detection at startup.
RUN test -f .muaddib/manifest.json || (echo "missing .muaddib/manifest.json at repo root — see muaddib/README.md" >&2 && exit 1)
RUN set -e; \
    PROJECT_PATHS="$(jq -r '.projects[].path' .muaddib/manifest.json)" \
        || { echo "failed to read .projects[].path from .muaddib/manifest.json" >&2; exit 1; }; \
    [ -n "$PROJECT_PATHS" ] || { echo "no projects[] entries found in .muaddib/manifest.json" >&2; exit 1; }; \
    for p in $PROJECT_PATHS; do \
        [ -f "$p/package.json" ] || continue; \
        echo "== installing deps: $p =="; \
        npm --prefix "$p" ci; \
        mkdir -p "/home/worker/.deps-lock/$p"; \
        cp "$p/package-lock.json" "/home/worker/.deps-lock/$p/package-lock.json"; \
    done

WORKDIR /home/worker
COPY --chown=worker:worker muaddib/claude/settings.json /home/worker/.claude/settings.json
# SDLC skills are project-owned, not muaddib's — see README ".muaddib/skills/".
# Copied from the repo already baked in above (not a fresh COPY from the host
# build context) so a missing directory fails with our own clear message —
# a host-context COPY's source is checksummed before any RUN step can run,
# so BuildKit's own generic "not found" would otherwise win the race.
RUN set -e; \
    [ -n "$(ls -A /home/worker/repo/.muaddib/skills 2>/dev/null)" ] \
        || { echo "missing or empty .muaddib/skills/ at repo root — see muaddib/README.md" >&2; exit 1; }; \
    cp -r /home/worker/repo/.muaddib/skills /home/worker/.claude/skills
# Pre-seed onboarding state so claude skips the theme picker / welcome / trust
# dialog and goes straight to the task. The entrypoint's `claude mcp add` merges
# mcpServers into this same file at runtime.
COPY --chown=worker:worker muaddib/claude/claude.json /home/worker/.claude.json
COPY --chown=worker:worker muaddib/claude/tmux.conf /home/worker/.tmux.conf
COPY --chown=worker:worker muaddib/worker-entrypoint.sh /home/worker/worker-entrypoint.sh

ENTRYPOINT ["bash", "/home/worker/worker-entrypoint.sh"]
